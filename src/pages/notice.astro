---
// 공지사항 (동적). 서버 GET /notices 에서 발행 공지를 불러와
// 목록(/notice) → 상세(/notice?id=N)로 렌더. LegalLayout 스타일 재사용.
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/peach2.png" />
    <meta name="description" content="Grameow 공지사항" />
    <title>공지사항 - Grameow</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <style is:global>
      :root {
        --color-text: #3D3934;
        --color-text-secondary: #787370;
        --color-text-tertiary: #B0ADA8;
        --color-bg: #F7F6F3;
        --color-surface: #FFFFFF;
        --color-border: #E8E6E1;
        --color-accent: #6BA3D6;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Pretendard Variable', -apple-system, sans-serif;
        background: var(--color-surface);
        color: var(--color-text);
        line-height: 1.7;
      }
      .legal-nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
        height: 56px; display: flex; align-items: center; padding: 0 24px;
      }
      .legal-nav a { display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--color-text); font-weight: 800; font-size: 16px; }
      .legal-nav img { width: 28px; height: 28px; }
      .legal-container { max-width: 720px; margin: 0 auto; padding: 88px 24px 80px; }
      .legal-container h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
      .legal-container .meta { color: var(--color-text-tertiary); font-size: 14px; margin-bottom: 36px; }
      .legal-container h2 { font-size: 17px; font-weight: 700; margin: 28px 0 10px; }
      .legal-container h3 { font-size: 15px; font-weight: 600; margin: 16px 0 8px; }
      .legal-container p, .legal-container li { font-size: 15px; color: var(--color-text-secondary); line-height: 1.75; }
      .legal-container ul, .legal-container ol { padding-left: 20px; margin: 6px 0; }
      .legal-container li { margin-bottom: 4px; }
      .legal-container table { width: 100%; border-collapse: collapse; margin: 10px 0 16px; font-size: 14px; }
      .legal-container th, .legal-container td { border: 1px solid var(--color-border); padding: 10px 14px; text-align: left; }
      .legal-container th { background: var(--color-bg); font-weight: 600; color: var(--color-text); }
      .legal-container td { color: var(--color-text-secondary); }
      .legal-container a { color: var(--color-accent); }
      .legal-container strong { color: var(--color-text); font-weight: 600; }
      .legal-container code { background: #F0EEE9; padding: 1px 5px; border-radius: 4px; font-size: 13px; }
      .legal-container blockquote { border-left: 3px solid var(--color-border); padding-left: 12px; color: var(--color-text-tertiary); margin: 10px 0; }
      /* 공지 목록 */
      .notice-list { list-style: none; padding: 0; }
      .notice-item { display: block; padding: 18px 4px; border-bottom: 1px solid var(--color-border); text-decoration: none; color: var(--color-text); }
      .notice-item .n-title { font-size: 16px; font-weight: 600; }
      .notice-item .n-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #E8917F; margin-left: 6px; vertical-align: middle; }
      .notice-item .n-date { font-size: 13px; color: var(--color-text-tertiary); margin-top: 4px; }
      .back-link { display: inline-block; margin-bottom: 20px; color: var(--color-accent); text-decoration: none; font-size: 14px; }
      .state { color: var(--color-text-tertiary); padding: 20px 0; }
    </style>
  </head>
  <body>
    <nav class="legal-nav">
      <a href="/"><img src="/images/peach2.png" alt="Grameow" /><span>Grameow</span></a>
    </nav>
    <div class="legal-container" id="root">
      <div class="state">불러오는 중...</div>
    </div>

    <script>
      import {renderMd} from '../admin/markdown';

      const API_BASE =
        window.location.hostname === 'localhost'
          ? 'http://localhost:3030'
          : 'https://grameow-server-production.up.railway.app';

      const root = document.getElementById('root')!;
      const esc = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const fmtDate = (iso: string) => (iso || '').slice(0, 10);

      type Notice = {id: number; title: string; content: string; createdAt: string};

      async function renderDetail(id: string) {
        try {
          const res = await fetch(`${API_BASE}/notices/${id}`);
          if (!res.ok) throw new Error();
          const n: Notice = await res.json();
          root.innerHTML =
            `<a class="back-link" href="/notice">← 목록으로</a>` +
            `<h1>${esc(n.title)}</h1>` +
            `<div class="meta">${fmtDate(n.createdAt)}</div>` +
            renderMd(n.content);
        } catch {
          root.innerHTML = `<a class="back-link" href="/notice">← 목록으로</a><div class="state">공지를 불러오지 못했습니다.</div>`;
        }
      }

      async function renderList() {
        try {
          const res = await fetch(`${API_BASE}/notices`);
          if (!res.ok) throw new Error();
          const list: Notice[] = await res.json();
          if (list.length === 0) {
            root.innerHTML = `<h1>공지사항</h1><div class="state">아직 등록된 공지가 없습니다.</div>`;
            return;
          }
          root.innerHTML =
            `<h1>공지사항</h1>` +
            `<div class="notice-list">` +
            list
              .map((n, i) => {
                // 가장 최신 공지이면서 작성일이 30일 이내면 dot
                const isRecent =
                  Date.now() - new Date(n.createdAt).getTime() <
                  30 * 24 * 60 * 60 * 1000;
                const dot = i === 0 && isRecent ? '<span class="n-dot"></span>' : '';
                return (
                  `<a class="notice-item" href="/notice?id=${n.id}">` +
                  `<div class="n-title">${esc(n.title)}${dot}</div>` +
                  `<div class="n-date">${fmtDate(n.createdAt)}</div></a>`
                );
              })
              .join('') +
            `</div>`;
        } catch {
          root.innerHTML = `<h1>공지사항</h1><div class="state">공지를 불러오지 못했습니다.</div>`;
        }
      }

      const id = new URLSearchParams(window.location.search).get('id');
      if (id) renderDetail(id);
      else renderList();
    </script>
  </body>
</html>
